rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasProfile() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function profile() {
      return get(userPath(request.auth.uid)).data;
    }

    function userRole() {
      return hasProfile() ? profile().role : null;
    }

    function userStoreId() {
      return hasProfile() ? profile().storeId : null;
    }

    function memberOf(storeId) {
      return hasProfile() && storeId is string && userStoreId() == storeId;
    }

    function ownerOf(storeId) {
      return memberOf(storeId) && userRole() == 'owner'
        && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
    }

    function managerOrOwner() {
      return hasProfile() && userRole() in ['owner', 'manager'];
    }

    function sameStoreAfterWrite(storeId) {
      return request.resource.data.storeId == storeId && memberOf(storeId);
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }

    // A first-time user may create only a store owned by their own Auth UID.
    match /stores/{storeId} {
      allow create: if signedIn()
        && request.resource.data.id == storeId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(['id', 'name', 'ownerId', 'address', 'phone', 'createdAt']);
      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid || memberOf(storeId)
      );
      allow update: if ownerOf(storeId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.id == resource.data.id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'address', 'phone']);
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId || memberOf(resource.data.storeId)
      );

      // Self-registration is allowed only for an owner profile backed by a store
      // document whose ownerId is this same Auth UID. Staff creation is owner-only.
      allow create: if signedIn() && request.resource.data.uid == userId && (
        (request.auth.uid == userId
          && request.resource.data.role == 'owner'
          && request.resource.data.storeId is string
          && exists(/databases/$(database)/documents/stores/$(request.resource.data.storeId))
          && get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.ownerId == request.auth.uid)
        || (managerOrOwner()
          && userRole() == 'owner'
          && request.resource.data.role in ['manager', 'cashier']
          && request.resource.data.storeId == userStoreId()
          && request.resource.data.createdById == request.auth.uid)
      );

      // Users may change only their own display/contact fields. Role and store
      // membership are immutable to the user. Owners can administer staff only.
      allow update: if signedIn() && request.resource.data.uid == userId && (
        (request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.storeId == resource.data.storeId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'photoURL']))
        || (ownerOf(resource.data.storeId)
          && resource.data.role in ['manager', 'cashier']
          && request.resource.data.storeId == resource.data.storeId
          && request.resource.data.role in ['manager', 'cashier']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'displayName', 'email', 'photoURL']))
      );
      allow delete: if signedIn()
        && ownerOf(resource.data.storeId)
        && resource.data.role in ['manager', 'cashier']
        && userId != request.auth.uid;
    }

    match /products/{productId} {
      allow read: if memberOf(resource.data.storeId);
      allow create: if managerOrOwner() && sameStoreAfterWrite(request.resource.data.storeId);
      allow update: if managerOrOwner()
        && memberOf(resource.data.storeId)
        && request.resource.data.storeId == resource.data.storeId;
      // Cashiers may only adjust stock during checkout.
      allow update: if hasProfile() && userRole() == 'cashier'
        && memberOf(resource.data.storeId)
        && request.resource.data.storeId == resource.data.storeId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt']);
      allow delete: if managerOrOwner() && memberOf(resource.data.storeId);
    }

    match /transactions/{transactionId} {
      allow read: if memberOf(resource.data.storeId);
      allow create: if hasProfile()
        && userRole() in ['owner', 'manager', 'cashier']
        && sameStoreAfterWrite(request.resource.data.storeId);
      allow update: if false;
      allow delete: if managerOrOwner() && memberOf(resource.data.storeId);
    }

    match /settings/{storeId} {
      allow read: if memberOf(storeId) && resource.data.storeId == storeId;
      allow create: if ownerOf(storeId)
        && request.resource.data.storeId == storeId;
      allow update: if ownerOf(storeId)
        && resource.data.storeId == storeId
        && request.resource.data.storeId == storeId;
      allow delete: if false;
    }

    match /receiptTemplates/{templateId} {
      allow read: if memberOf(resource.data.storeId);
      allow create: if managerOrOwner() && sameStoreAfterWrite(request.resource.data.storeId);
      allow update: if managerOrOwner()
        && memberOf(resource.data.storeId)
        && request.resource.data.storeId == resource.data.storeId;
      allow delete: if managerOrOwner() && memberOf(resource.data.storeId);
    }

    match /cashFlows/{cashFlowId} {
      allow read: if memberOf(resource.data.storeId);
      allow create: if hasProfile() && sameStoreAfterWrite(request.resource.data.storeId);
      allow update: if hasProfile()
        && memberOf(resource.data.storeId)
        && request.resource.data.storeId == resource.data.storeId;
      allow delete: if managerOrOwner() && memberOf(resource.data.storeId);
    }

    match /capital/{capitalId} {
      allow read: if memberOf(resource.data.storeId);
      allow create: if managerOrOwner() && sameStoreAfterWrite(request.resource.data.storeId);
      allow update, delete: if managerOrOwner()
        && memberOf(resource.data.storeId)
        && request.resource.data.storeId == resource.data.storeId;
    }

    match /debts/{debtId} {
      allow read: if memberOf(resource.data.storeId);
      allow create: if hasProfile() && sameStoreAfterWrite(request.resource.data.storeId);
      allow update: if hasProfile()
        && memberOf(resource.data.storeId)
        && request.resource.data.storeId == resource.data.storeId;
      allow delete: if managerOrOwner() && memberOf(resource.data.storeId);
    }
  }
}
