{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account and profile with store-based role hierarchy",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "Email address" },
        "displayName": { "type": "string", "description": "Display name of user" },
        "photoURL": { "type": "string", "description": "Profile avatar URL" },
        "role": { "type": "string", "enum": ["owner", "manager", "cashier"], "description": "User permission role" },
        "storeId": { "type": "string", "description": "ID of the store this user belongs to" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation timestamp" },
        "createdById": { "type": "string", "description": "UID of the owner who created this account" }
      },
      "required": ["uid", "email", "role", "storeId"]
    },
    "Store": {
      "title": "Store",
      "description": "Store entity created by owner",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100, "description": "Store name" },
        "ownerId": { "type": "string", "description": "Firebase Auth UID of the store owner" },
        "address": { "type": "string", "maxLength": 200, "description": "Store physical address" },
        "phone": { "type": "string", "maxLength": 30, "description": "Store phone number" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Store creation timestamp" }
      },
      "required": ["name", "ownerId"]
    },
    "Product": {
      "title": "Product",
      "description": "Store inventory product item scoped by storeId",
      "type": "object",
      "properties": {
        "storeId": { "type": "string", "description": "Owner store identifier" },
        "name": { "type": "string", "maxLength": 100, "description": "Product title" },
        "sku": { "type": "string", "maxLength": 30, "description": "Stock keeping unit" },
        "price": { "type": "number", "description": "Product selling price" },
        "stock": { "type": "number", "description": "Available stock quantity" },
        "category": { "type": "string", "maxLength": 50, "description": "Category name" },
        "barcode": { "type": "string", "maxLength": 50, "description": "Optional barcode" },
        "color": { "type": "string", "maxLength": 20, "description": "Accent label color hex" },
        "description": { "type": "string", "maxLength": 250, "description": "Product details" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last updated timestamp" }
      },
      "required": ["storeId", "name", "sku", "price", "stock", "category"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Recorded POS sales transaction receipt scoped by storeId",
      "type": "object",
      "properties": {
        "storeId": { "type": "string", "description": "Owner store identifier" },
        "invoiceNumber": { "type": "string", "maxLength": 50, "description": "Unique receipt invoice number" },
        "timestamp": { "type": "number", "description": "Epoch timestamp of checkout" },
        "items": { "type": "array", "description": "Purchased items with quantity and unit price" },
        "subtotal": { "type": "number", "description": "Subtotal amount before discount/tax" },
        "discount": { "type": "number", "description": "Discount deduction" },
        "tax": { "type": "number", "description": "Tax addition" },
        "total": { "type": "number", "description": "Final total amount" },
        "paidAmount": { "type": "number", "description": "Tendered amount" },
        "changeAmount": { "type": "number", "description": "Calculated change amount" },
        "paymentMethod": { "type": "string", "enum": ["cash", "qris", "transfer"], "description": "Payment type" },
        "cashierName": { "type": "string", "maxLength": 50, "description": "Cashier on duty name" },
        "cashierId": { "type": "string", "description": "Cashier UID" },
        "notes": { "type": "string", "maxLength": 200, "description": "Optional transaction notes" }
      },
      "required": ["storeId", "invoiceNumber", "timestamp", "items", "total", "paidAmount", "paymentMethod"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Store profile and 58mm thermal receipt printer configuration",
      "type": "object",
      "properties": {
        "storeId": { "type": "string", "description": "Owner store identifier" },
        "storeName": { "type": "string", "maxLength": 50, "description": "Store name printed on receipt header" },
        "address": { "type": "string", "maxLength": 120, "description": "Store street address" },
        "phone": { "type": "string", "maxLength": 30, "description": "Customer service telephone number" },
        "receiptHeader": { "type": "string", "maxLength": 100, "description": "Custom header message above items" },
        "receiptFooter": { "type": "string", "maxLength": 150, "description": "Footer message on receipt bottom" },
        "paperWidthChars": { "type": "number", "description": "Columns width, standard 32 chars for 58mm" },
        "currencyPrefix": { "type": "string", "maxLength": 10, "description": "Currency prefix e.g. Rp" },
        "enableTax": { "type": "boolean", "description": "Whether tax calculation is enabled" },
        "taxRate": { "type": "number", "description": "Tax percentage e.g. 10%" },
        "cashierName": { "type": "string", "maxLength": 50, "description": "Default cashier name" },
        "linuxDevicePath": { "type": "string", "maxLength": 50, "description": "Thermal printer port e.g. /dev/usb/lp0" },
        "autoCut": { "type": "boolean", "description": "Whether to send auto-cut command after print" },
        "autoDrawer": { "type": "boolean", "description": "Whether to send kick drawer pulse on cash sale" }
      },
      "required": ["storeName", "paperWidthChars", "currencyPrefix"]
    },
    "CustomTemplate": {
      "title": "CustomTemplate",
      "description": "OCR Receipt Metadata template kustom",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique ID template" },
        "storeId": { "type": "string", "description": "ID toko opsional" },
        "name": { "type": "string", "description": "Nama template" },
        "badgeTitle": { "type": "string", "description": "Status badge title" },
        "metadata": { "type": "array", "description": "Daftar metadata item kustom" },
        "footerNote": { "type": "string", "description": "Catatan kaki struk kustom" },
        "createdAt": { "type": "number", "description": "Timestamp pembuatan" },
        "updatedAt": { "type": "string", "description": "Timestamp pembaruan" }
      },
      "required": ["id", "name", "metadata"]
    },
    "CashFlow": {
      "title": "CashFlow",
      "description": "Pencatatan arus kas pemasukan dan pengeluaran toko",
      "type": "object",
      "properties": {
        "storeId": { "type": "string", "description": "ID toko" },
        "type": { "type": "string", "enum": ["income", "expense"], "description": "Tipe arus kas" },
        "category": { "type": "string", "description": "Kategori transaksi" },
        "description": { "type": "string", "description": "Deskripsi atau keperluan" },
        "amount": { "type": "number", "description": "Nominal transaksi" },
        "cost": { "type": "number", "description": "Harga modal (opsional)" },
        "profit": { "type": "number", "description": "Laba bersih (opsional)" },
        "status": { "type": "string", "enum": ["lunas", "belum_lunas"], "description": "Status pembayaran" },
        "paymentMethod": { "type": "string", "description": "Metode pembayaran" },
        "timestamp": { "type": "number", "description": "Timestamp epoch" },
        "dateString": { "type": "string", "description": "Format tanggal YYYY-MM-DD" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["type", "category", "amount", "status", "timestamp", "dateString"]
    },
    "Debt": {
      "title": "Debt",
      "description": "Buku Bon dan hutang piutang pelanggan",
      "type": "object",
      "properties": {
        "storeId": { "type": "string", "description": "ID toko" },
        "customerName": { "type": "string", "description": "Nama pelanggan" },
        "customerPhone": { "type": "string", "description": "Nomor WhatsApp atau HP" },
        "description": { "type": "string", "description": "Rincian barang atau keperluan" },
        "totalAmount": { "type": "number", "description": "Total nominal hutang" },
        "paidAmount": { "type": "number", "description": "Nominal yang sudah dibayar" },
        "remainingAmount": { "type": "number", "description": "Sisa hutang" },
        "status": { "type": "string", "enum": ["belum_lunas", "cicilan", "lunas"], "description": "Status hutang" },
        "createdAt": { "type": "number", "description": "Timestamp pembuatan" },
        "dueDate": { "type": "string", "description": "Tanggal jatuh tempo (opsional)" },
        "payments": { "type": "array", "description": "Riwayat cicilan atau pembayaran" },
        "updatedAt": { "type": "number", "description": "Timestamp pembaruan terakhir" }
      },
      "required": ["customerName", "totalAmount", "remainingAmount", "status", "createdAt"]
    }
  },
  "firestore": {
    "/cashFlows/{cashFlowId}": {
      "schema": { "$ref": "CashFlow" },
      "description": "Cash flow records for income and expense bookkeeping"
    },
    "/debts/{debtId}": {
      "schema": { "$ref": "Debt" },
      "description": "Customer debts and installment tracking records"
    },
    "/receiptTemplates/{templateId}": {
      "schema": { "$ref": "CustomTemplate" },
      "description": "Custom metadata templates for OCR scanning"
    },
    "/stores/{storeId}": {
      "schema": { "$ref": "Store" },
      "description": "Store profiles"
    },
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profiles and store role hierarchy"
    },
    "/products/{productId}": {
      "schema": { "$ref": "Product" },
      "description": "Store inventory products catalog"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "Transaction" },
      "description": "Sales history transactions"
    },
    "/settings/{settingsId}": {
      "schema": { "$ref": "StoreSettings" },
      "description": "Store and thermal printer configurations"
    }
  }
}
